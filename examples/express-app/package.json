{
  "name": "example-express-app",
  "version": "0.0.0",
  "private": true,
  "description": "Lightweight typescript express app using wiremock for testing",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/body-parser": "1.19.6",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.1.2",
    "@types/supertest": "7.2.1",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jest": "29.16.0",
    "globals": "17.9.0",
    "jest": "30.4.2",
    "jest-cli": "30.4.2",
    "nodemon": "3.1.14",
    "npm-check-updates": "23.0.1",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "wiremock-captain": "file:../../"
  },
  "scripts": {
    "dev": "npm run build && NODE_ENV=DEVELOPMENT nodemon ./dist/src/server.js",
    "prod": "npm run build && NODE_ENV=PRODUCTION nodemon ./dist/server.js",
    "clean": "rimraf coverage dist tmp",
    "build": "npm run clean && tsc && npm run lint",
    "lint": "eslint .",
    "test": "jest --runInBand --forceExit",
    "check-package-updates": "ncu",
    "make-package-updates": "ncu -u"
  },
  "dependencies": {
    "axios": "1.19.0",
    "body-parser": "2.3.0",
    "express": "5.2.1"
  }
}
